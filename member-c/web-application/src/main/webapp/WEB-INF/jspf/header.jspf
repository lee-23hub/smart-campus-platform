<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}" default="SCASP"/> - Smart Campus</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css">
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header class="topbar">
  <span class="brand">SCASP</span>
  <c:if test="${not empty sessionScope.user}">
    <nav aria-label="Main navigation">
      <a href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
      <a href="${pageContext.request.contextPath}/courses">Courses</a>
      <a href="${pageContext.request.contextPath}/registrations">Registrations</a>
      <a href="${pageContext.request.contextPath}/requests">Requests</a>
      <c:if test="${sessionScope.user.role == 'STAFF'}">
        <a href="${pageContext.request.contextPath}/reports">Reports</a>
      </c:if>
    </nav>
    <form class="logout" method="post" action="${pageContext.request.contextPath}/logout">
      <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>">
      <span><c:out value="${sessionScope.user.name}"/> (<c:out value="${sessionScope.user.role}"/>)</span>
      <button type="submit">Log out</button>
    </form>
  </c:if>
</header>
<main id="main">
<%@ include file="/WEB-INF/jspf/messages.jspf" %>
